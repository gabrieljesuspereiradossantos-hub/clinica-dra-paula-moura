---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans/index.css';
import tokens from '../styles/tokens.css?raw';
import heroCss from '../styles/hero.css?raw';
import { site, links, reviewMode } from '../config/site';
import { closing } from '../content/content';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  /** página interna (ex.: privacidade): sem barra de ação no celular */
  inner?: boolean;
  schema?: Record<string, unknown>;
}

const { title = site.seo.title, description = site.seo.description, inner = false, schema } = Astro.props;
const base = site.url || '';
const canonical = site.url ? new URL(Astro.url.pathname, site.url + '/').href : '';
const ogImage = base ? base + site.seo.ogImage : site.seo.ogImage;
const home = inner ? '/' : '';
const year = new Date().getFullYear();
---
<!doctype html>
<!-- kind: service · deal: hero split, nav-mega, close-type, footer-columns, rhythm space, buttons solid,
     mark: logo da cliente · palette: cores da marca (logo) · type: instrument-serif · moment: word-highlight -->
<html lang="pt-BR" data-type="service" data-radius="soft" data-buttons="solid" data-motion data-review={reviewMode ? '' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:locale" content="pt_BR">
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{canonical && <meta property="og:url" content={canonical} />}
<meta name="twitter:card" content="summary_large_image">
{canonical && <link rel="canonical" href={canonical} />}
{reviewMode && <meta name="robots" content="noindex, nofollow" />}
<link rel="icon" href="/favicon.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content={site.seo.themeColor}>
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style is:inline set:html={tokens}></style>
{!inner && <style is:inline set:html={heroCss}></style>}
{!inner && <noscript><style is:inline>{"#intro { display: none; }"}</style></noscript>}
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
{!inner && <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>}
{!inner && <link rel="modulepreload" href="/assets/moments/moments.js" />}
{!inner && <link rel="modulepreload" href="/assets/moments/lib.js" />}
{!inner && <link rel="modulepreload" href="/assets/moments/word-highlight/moment.js" />}
{schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
</head>
<body>
{!inner && (
  <>
  <!-- Tela de abertura (padrão Solenime): no HTML, antes do JS, uma vez por sessão.
       Enquanto ela está na frente, a entrada do hero espera (html.is-loading). -->
  <div id="intro" aria-hidden="true">
    <div class="i-mark">
      <img class="i-logo" src={site.logo.small} alt="" width="72" height="72" />
      <span class="i-word">{site.shortName.split("").map((c, i) => (
        <span class="sh" style={`--i: ${i}`}><span class="sh-main">{c === " " ? " " : c}</span><span class="sh-s sh-t">{c}</span><span class="sh-s sh-m">{c}</span><span class="sh-s sh-b">{c}</span></span>
      ))}</span>
      <span class="i-small">Estética avançada</span>
      <span class="i-line"><i></i></span>
    </div>
    <span class="i-foot">{site.address.city}</span>
  </div>
  <script is:inline>
    (function () {
      var html = document.documentElement, intro = document.getElementById('intro'), seen = false;
      try { seen = sessionStorage.getItem('dpm-intro') === '1'; } catch (e) {}
      if (seen || !intro) { html.classList.add('no-intro'); if (intro) intro.remove(); return; }
      // a cascata própria do hero assume; a entrada do kit fica desligada nesta visita
      html.classList.add('is-loading', 'has-intro');
      html.classList.remove('m-enter');
      // a primeira visita começa sempre no topo: o navegador do celular restaurava a rolagem de uma visita
      // anterior (ou de um toque durante a abertura) e a página abria já no vídeo da Dra. Paula
      var deep = !!location.hash;
      try { if (!deep && 'scrollRestoration' in history) history.scrollRestoration = 'manual'; } catch (e) {}
      var toTop = function () { if (!deep) window.scrollTo(0, 0); };
      toTop();
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var MIN = reduce ? 400 : 2100, MAX = 4000, start = Date.now(), finished = false;
      var wait = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };
      var font = document.fonts && document.fonts.load ? document.fonts.load('italic 400 1em "Instrument Serif"') : Promise.resolve();
      var ready = function () { intro.classList.add('is-ready'); };
      // setTimeout em vez de requestAnimationFrame: rAF não dispara com a aba em segundo plano
      Promise.race([font, wait(700)]).then(function () { setTimeout(ready, 16); }, function () { setTimeout(ready, 16); });
      function finish() {
        if (finished) return; finished = true; ready();
        setTimeout(function () {
          intro.classList.add('is-done');
          setTimeout(function () {
            toTop();
            intro.classList.add('is-out');
            html.classList.remove('is-loading');
            try { history.scrollRestoration = 'auto'; } catch (e) {}
            try { sessionStorage.setItem('dpm-intro', '1'); } catch (e) {}
            setTimeout(function () { intro.remove(); }, 1000);
          }, 340);
        }, Math.max(0, MIN - (Date.now() - start)));
      }
      window.addEventListener('load', function () { Promise.race([document.fonts ? document.fonts.ready : Promise.resolve(), wait(1200)]).then(finish); });
      setTimeout(finish, MAX);
    })();
  </script>
  </>
)}
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Pular para o conteúdo</a>
    <a class="nav__logo" href={inner ? '/' : '#top'} aria-label={`${site.shortName}, estética avançada: início`}><img class="logo-img" src={site.logo.nav} alt="" width="56" height="56"><span class="logo-text"><span class="logo-name">{site.shortName}</span><span class="logo-sub">Estética avançada</span></span></a>
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item"><a class="nav__link" href={`${home}#sobre`}>Sobre</a></div>
      <div class="nav__item">
        <a class="nav__link" href={`${home}#cuidados`}>Cuidados <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-3">
              <p class="t-label">Rosto</p>
              <a href={`${home}#cuidados`}>Harmonização facial<span>Proporção e equilíbrio</span></a>
              <a href={`${home}#cuidados`}>Estética facial<span>Viço e textura da pele</span></a>
              <a href={`${home}#cuidados`}>Qualidade da pele<span>Firmeza e hidratação</span></a>
            </div>
            <div class="menu-col span-3">
              <p class="t-label">Corpo e bem-estar</p>
              <a href={`${home}#cuidados`}>Estética corporal<span>Contorno e firmeza</span></a>
              <a href={`${home}#head-spa`}>Head Spa<span>Três pacotes, de R$ 180</span></a>
              <a href={`${home}#cuidados`}>Protocolos personalizados<span>Definidos na avaliação</span></a>
            </div>
            <div class="menu-col span-3">
              <p class="t-label">Antes de tudo</p>
              <a href={`${home}#avaliacao`}>Como é a avaliação<span>Quatro etapas, sem pressa</span></a>
              <a href={`${home}#duvidas`}>Perguntas frequentes<span>Agenda, local e contato</span></a>
            </div>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href={`${home}#head-spa`}>Head Spa</a></div>
      <div class="nav__item"><a class="nav__link" href={`${home}#avaliacao`}>Avaliação</a></div>
      <div class="nav__item"><a class="nav__link" href={`${home}#duvidas`}>Dúvidas</a></div>
      <div class="nav__item"><a class="nav__link" href={`${home}#contato`}>Contato</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={links.booking} target="_blank" rel="noopener">Agendar avaliação</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Abrir menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer closing" id="fim" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">{closing.title}</h2>
        <p>{closing.line}</p>
      </div>
      <a class="btn btn--primary btn--xl" href={links.booking} target="_blank" rel="noopener">Agendar avaliação<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href={inner ? '/' : '#top'} aria-label={`${site.shortName}, estética avançada: início`}><img class="logo-img" src={site.logo.nav} alt="" width="56" height="56" loading="lazy" decoding="async"><span class="logo-text"><span class="logo-name">{site.shortName}</span><span class="logo-sub">Estética avançada</span></span></a>
          <p class="footer__lede">{closing.lede}</p>
        </div>
        <div class="span-2 footer__col"><h3>Clínica</h3><ul><li><a href={`${home}#sobre`}>Sobre</a></li><li><a href={`${home}#cuidados`}>Cuidados</a></li><li><a href={`${home}#head-spa`}>Head Spa</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Atendimento</h3><ul><li><a href={`${home}#avaliacao`}>Avaliação</a></li><li><a href={`${home}#duvidas`}>Dúvidas</a></li><li><a href={`${home}#contato`}>Contato</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Endereço</h3>
          <ul>
            <li>{site.address.street}, {site.address.complement}</li>
            <li>{site.address.district}, {site.address.city} – {site.address.state}</li>
          </ul>
        </div>
        <div class="span-2 footer__col"><h3>Contato</h3>
          <ul>
            <li><a href={links.phone}>{site.contact.phoneDisplay}</a></li>
            <li><a href={links.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
            <li><a href={links.maps} target="_blank" rel="noopener">Google Maps</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__legal">
        <span>&copy; {year} {site.name} &nbsp; <a href="/privacidade/">Política de privacidade</a></span>
        <div class="socials"><a href={links.instagram} target="_blank" rel="noopener" aria-label="Instagram da Dra. Paula Moura"><Icon name="instagram" /></a></div>
      </div>
    </div>
  </div>
</footer>

{!inner && (
  <nav class="actionbar" aria-label="Ações rápidas">
    <a class="btn btn--primary" href={links.booking} target="_blank" rel="noopener">Agendar avaliação</a>
  </nav>
)}

<script type="module" is:inline src="/assets/system.js"></script>
<script type="module" is:inline src="/assets/motion/motion.js"></script>
<script type="module" is:inline src="/assets/layout/layout.js"></script>
</body>
</html>
